# Скопируйте этот файл в .env и заполните значения.
# cp .env.example .env

# Токен от @BotFather (вида 123456789:AAH...)
BOT_TOKEN=

# ID группы закупок (число со знаком минус, напр. -1001234567890).
# Узнаётся через get_ids.py
GROUP_CHAT_ID=

# user.id директора и бухгалтера (узнаются командой /id в личке с ботом)
DIRECTOR_ID=
ACCOUNTANT_ID=

# --- Логистика (общая на все секторы, личные чаты с тем же ботом) ---
# Пусто/0 — этап логистики выключен (цикл заканчивается на «оплачено»).
# DRIVER_ID — водитель (кнопка «🚚 Еду за товаром»)
# WAREHOUSE_ID — склад/цех (кнопка «📦 Принял на складе»)
DRIVER_ID=
WAREHOUSE_ID=

# Необязательно: путь к файлу БД (по умолчанию zakupki.db рядом со скриптом)
# DB_PATH=zakupki.db

# --- Мини-приложение (форма заявки) ---
# Публичный HTTPS-адрес страницы формы. Пусто = /new покажет старый пошаговый
# мастер вместо формы. На проде (Диветро): https://ваш-домен/divetro/form
WEBAPP_URL=
# Куда веб-сервер формы биндится локально (наружу отдаёт nginx с TLS).
# ВАЖНО (Диветро): порт 8081 — на том же сервере 8080 занят Бертамом.
WEB_HOST=127.0.0.1
WEB_PORT=8081

# Окно загрузки платёжки (pay.html). Обычно задавать НЕ нужно — выводится из
# WEBAPP_URL автоматически (.../form → .../pay). Переопределяйте, только если
# адрес окна платёжки отличается от адреса формы.
# PAYAPP_URL=
